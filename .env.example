# 复制为 .env 后在服务器上填写。不要提交 .env，不要把私钥写进这个文件。
# Copy to .env on the server. Never commit .env or a real private key.

# --- 链 / chain ---
AEVUM_RPC_URL=https://rpc-test.qday.info
# 浏览器钱包使用的 RPC。空则与 AEVUM_RPC_URL 相同。
AEVUM_PUBLIC_RPC_URL=
AEVUM_CHAIN_ID=44005
# forge script 部署后填入。
CONTRACT_ADDRESS=
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
# 设成部署交易的区块号，索引器从这里开始扫。
START_BLOCK=
EXPLORER_URL=https://explorer-test.qday.info
CHAIN_CONFIRMATIONS=2
CHAIN_POLL_INTERVAL_MS=3000
CHAIN_LOG_BATCH_BLOCKS=2000
CHAIN_REORG_DEPTH=10

# --- 操作员热钱包：二选一。只付 gas，不能动用户的 tUSD8。 ---
# Hex private key. Leave empty to run the indexer without operator transactions.
AEVUM_OPERATOR_PRIVATE_KEY=
# 或者加密 keystore 的容器内路径 + 密码。文件用 volume 挂进 /secrets，权限 600。
AEVUM_OPERATOR_KEYSTORE=
AEVUM_OPERATOR_KEYSTORE_PASSWORD=

# 只给 forge script 用，运行时的后端不读这个变量。
DEPLOYER_PRIVATE_KEY=

# --- Postgres ---
POSTGRES_DB=aevumpay
POSTGRES_USER=aevumpay
POSTGRES_PASSWORD=

# --- 应用 ---
SERVER_PORT=8080
# 浏览器上的站点根，用来拼支付链接。例如 https://pay.example.com
PUBLIC_BASE_URL=https://pay.example.com
WEBHOOK_DISPATCH_INTERVAL_MS=2000
WEBHOOK_RETRY_SECONDS=60,300,1800,7200,43200
RECONCILE_INTERVAL_MS=600000
